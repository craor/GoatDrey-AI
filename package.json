{
  "name": "goatdrey-ai",
  "productName": "GoatDrey AI",
  "version": "1.2.0",
  "description": "GoatDrey AI — настольный помощник для Windows 10/11 и macOS: чат, поиск, управление компьютером. Думает на вашем компьютере (Ollama) или через любой ключ API.",
  "main": "src/main/main.js",
  "author": "GoatDrey",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "node scripts/smoke-groq.js",
    "test": "node scripts/smoke-providers.js && node scripts/smoke-groq.js && node scripts/smoke-search.js && node scripts/smoke-md.js && node scripts/smoke-ollama.js",
    "icons": "python scripts/make-icons.py",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:dir": "electron-builder --dir --publish never",
    "dist:win-installer": "electron-builder --win nsis --x64 --publish never",
    "fix:electron": "node node_modules/electron/install.js",
    "smoke:providers": "node scripts/smoke-providers.js",
    "smoke:ollama": "node scripts/smoke-ollama.js",
    "dist:win-portable": "electron-builder --win portable --x64 --publish never",
    "release:win": "electron-builder --win nsis --x64 --publish always",
    "dist:mac": "electron-builder --mac dmg zip --universal --publish never",
    "icons:mac": "python3 -c \"from PIL import Image;im=Image.open('assets/icon/icon-1024.png');im.save('assets/icon/icon.icns')\""
  },
  "build": {
    "appId": "ai.goatdrey.desktop",
    "productName": "GoatDrey AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "config.local.json",
        "to": "config.local.json",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "artifactName": "GoatDrey-AI-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "GoatDrey AI",
      "menuCategory": false,
      "uninstallDisplayName": "GoatDrey AI ${version}",
      "installerIcon": "assets/icon/icon.ico",
      "uninstallerIcon": "assets/icon/icon.ico",
      "installerHeaderIcon": "assets/icon/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "language": "1049",
      "multiLanguageInstaller": true,
      "artifactName": "GoatDrey-AI-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "GoatDrey-AI-${version}-portable.exe"
    },
    "mac": {
      "icon": "assets/icon/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "11.0",
      "darkModeSupport": true,
      "artifactName": "GoatDrey-AI-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "GoatDrey слушает микрофон только когда вы нажали кнопку голосового ввода.",
        "NSAppleEventsUsageDescription": "GoatDrey управляет программами (System Events) только в режиме «Компьютер» и с вашего разрешения.",
        "LSApplicationCategoryType": "public.app-category.productivity"
      }
    },
    "dmg": {
      "title": "GoatDrey AI ${version}",
      "artifactName": "GoatDrey-AI-${version}-mac-${arch}.${ext}",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 400
      }
    },
    "afterPack": "scripts/after-pack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "craor",
        "repo": "GoatDrey-AI",
        "private": true,
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "resedit": "^2.0.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
